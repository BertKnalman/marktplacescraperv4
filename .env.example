# ============ Supabase (frontend-safe) ============
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ============ Supabase (SERVER-ONLY — never expose) ============
SUPABASE_SERVICE_ROLE_KEY=

# ============ Translation (SERVER-ONLY) ============
# provider: local | deepl | openai
TRANSLATION_PROVIDER=local
TRANSLATION_API_KEY=
TRANSLATION_MODEL=dictionary-v1

# ============ Scraper engine ============
SCRAPER_MAX_CONCURRENCY=3
SCRAPER_REQUEST_DELAY_MIN=1000
SCRAPER_REQUEST_DELAY_MAX=3000
SCRAPER_TIMEOUT=30000
SCRAPER_MAX_RETRIES=2
